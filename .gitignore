# Local credentials and per-reservation machine settings.
.env
.env.*
!.env.example
.netrc
*.key
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519*
/configs/serving/lease-*.json

# Maintenance payloads contain old source snapshots and machine evidence.
# Keep these local; the final reports and historical script recipes remain.
/docs/maintenance/
**/_work/

# Python/build/editor caches.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
