# Model definitions in models/ ARE source code and must remain tracked.
# Complete weights, adapters, optimizer states and dataset files are not source.
/checkpoints/
/runs/
/logs/
/datasets/
/data/
/outputs/
/output/
/wandb/
*.safetensors
*.safetensors.index.json
*.pt
*.pth
*.ckpt
*.bin
*.gguf
*.ggml
*.onnx
*.h5
*.hdf5
*.tflite
*.pb
*.msgpack
*.model
*.tiktoken
*.npz
*.npy
*.pkl
*.pickle
*.jsonl
*.parquet
